import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{PROJECT_NAME}}/main.dart';

void main() {
  testWidgets('game boots and renders', (tester) async {
    final options = PlayerOptionsManager(InMemoryPlayerOptionsStorage());
    final game = MyGame(const GameConfig(worldWidth: 800, worldHeight: 600), options);
    await tester.pumpWidget(MaterialApp(home: GameRunner(game: game)));

    await tester.pump();
    await tester.pump();

    expect(find.byType(EngineView), findsOneWidget);
  });
}
