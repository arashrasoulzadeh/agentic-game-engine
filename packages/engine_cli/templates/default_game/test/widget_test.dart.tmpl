import 'package:engine_flutter/engine_flutter.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{PROJECT_NAME}}/main.dart';

void main() {
  testWidgets('game boots and renders', (tester) async {
    final game = MyGame(const GameConfig(worldWidth: 800, worldHeight: 600));
    await tester.pumpWidget(MaterialApp(home: GameRunner(game: game)));

    // Let the async asset-loading Future resolve, then let the
    // FutureBuilder rebuild with the loaded game.
    await tester.pump();
    await tester.pump();

    expect(find.byType(EngineView), findsOneWidget);
  });
}
