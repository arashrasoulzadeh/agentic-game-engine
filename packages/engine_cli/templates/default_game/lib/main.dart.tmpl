import 'dart:convert';
import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:engine_platformer/engine_platformer.dart';
import 'package:flutter/material.dart' hide Velocity, Action;
import 'package:flutter/services.dart' show LogicalKeyboardKey, rootBundle;

const _playtestLevel = String.fromEnvironment('PLAYTEST_LEVEL');
const _assetDir = String.fromEnvironment('ASSET_DIR');

// Generated by `game_agent create` — replace this with your own game.
//
// - assets/levels/main.level.json — tile geometry + player (data).
// - Escape opens pause → settings (PlayerOptions) / credits.
// - assets/i18n/en.json — stub catalog for i18n.keys / i18n.set.

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  final options = await createPlayerOptionsManager();
  runGame(MyGame(config, options));
}

class MyGame extends Game {
  MyGame(this._config, this.options);

  final GameConfig _config;
  final PlayerOptionsManager options;
  final AudioManager audio = AudioManager();

  late final InputController _inputController = InputController(
    bindings: {
      ...InputController.defaultBindings(),
      LogicalKeyboardKey.escape: 'pause',
    },
  );

  @override
  GameConfig get config => _config;

  @override
  String get colorblindMode =>
      options.options.colorblindMode;

  @override
  double get screenShakeIntensity {
    final o = options.options;
    return o.reduceMotion ? 0 : o.screenShakeIntensity;
  }

  @override
  InputController createInputController() => _inputController;

  @override
  Scene createInitialScene() => MainScene(this);
}

class MainScene extends Scene {
  MainScene(this.game);

  final MyGame game;
  late EntityId _player;
  late SceneController _scenes;
  AssetHotReloader? _reloader;
  bool _pauseHeld = false;

  @override
  Camera createCamera(World world) => Camera(zoom: 1);

  @override
  EntityId? cameraFollowEntity(World world) => _player;

  @override
  Future<void> populate(World world, SceneController scenes, GameState state) async {
    _scenes = scenes;
    registerPlatformerComponents(world);

    final levelAsset = _playtestLevel.isEmpty
        ? 'assets/levels/main.level.json'
        : 'assets/levels/$_playtestLevel';
    final diskAssets = _assetDir.isEmpty ? null : directoryAssetSource(_assetDir);
    final levelPath = levelAsset.substring('assets/'.length);
    final levelText = diskAssets == null
        ? await rootBundle.loadString(levelAsset)
        : utf8.decode(await diskAssets.read(levelPath));
    final levelJson = jsonDecode(levelText) as Map<String, dynamic>;
    final named = Level.loadInto(world, levelJson);

    _player = named['player']!;
    world.storeOf<InputState>().set(_player, game._inputController.state);
    world.storeOf<Health>().set(_player, Health(current: 100, max: 100));
    world.storeOf<Inventory>().set(_player, Inventory({'coin': 0}));

    final behaviors = BehaviorRegistry()
      ..register('patrol', PatrolBehavior(minX: 280, maxX: 480, speed: 60));
    installPlatformerSystems(world, player: _player, behaviors: behaviors);

    spawnEnemy(
      world,
      x: 400,
      y: 400,
      behaviorId: 'patrol',
      affectedByGravity: true,
      maxHealth: 20,
      atlasId: 'default',
      spriteRegion: 'enemy',
    );
    spawnHealthHudBar(world, source: _player, x: 20, y: 20, width: 200, height: 20);

    final coin = world.spawn();
    world.storeOf<Position>().set(coin, Position(450, 380));
    world.storeOf<Collider>().set(coin, Collider(8));
    world.storeOf<Sprite>().set(coin, Sprite('default', 'coin'));
    dealPickupOnTouch(world, {coin}, 'coin');

    if (diskAssets != null) {
      _reloader?.stop();
      _reloader = AssetHotReloader(
        source: diskAssets,
        handlers: [
          CallbackAssetHandler({levelPath}, (_) => scenes.loadScene(MainScene(game))),
        ],
      )..start();
    }
  }

  @override
  void update(double dt, World world) {
    final down = game._inputController.state.isPressed('pause');
    if (down && !_pauseHeld) {
      _scenes.pushOverlay(PauseMenu(game));
    }
    _pauseHeld = down;
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    final atlasRegistry = AtlasRegistry();
    atlasRegistry.register('default', await _placeholderAtlas());
    return atlasRegistry;
  }

  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawRect(const Rect.fromLTWH(0, 0, size, size), Paint()..color = Colors.cyanAccent);
    canvas.drawRect(const Rect.fromLTWH(size, 0, size, size), Paint()..color = Colors.orangeAccent);
    canvas.drawCircle(const Offset(size * 2.5, size / 2), 8, Paint()..color = Colors.amber);
    final image = await recorder.endRecording().toImage(size.toInt() * 3, size.toInt());
    return SpriteAtlas(image, {
      'player': const Rect.fromLTWH(0, 0, size, size),
      'enemy': const Rect.fromLTWH(size, 0, size, size),
      'coin': const Rect.fromLTWH(size * 2, 0, size, size),
    });
  }
}

class PauseMenu extends ButtonMenuScene {
  PauseMenu(this.game);
  final MyGame game;

  @override
  List<MenuButtonSpec> buttons() => const [
        MenuButtonSpec(label: 'Resume', actionId: 'resume'),
        MenuButtonSpec(label: 'Settings', actionId: 'settings'),
        MenuButtonSpec(label: 'Credits', actionId: 'credits'),
      ];

  @override
  void onButtonPressed(String actionId, SceneController scenes) {
    switch (actionId) {
      case 'resume':
        scenes.popOverlay();
      case 'settings':
        scenes.pushOverlay(GameSettingsMenu(game)..optionsManager = game.options);
      case 'credits':
        scenes.pushOverlay(GameCredits());
    }
  }
}

class GameSettingsMenu extends SettingsMenuScene {
  GameSettingsMenu(this.game);
  final MyGame game;

  @override
  String? get title => 'Settings';

  @override
  List<SettingsWidgetSpec> get widgets => const [
        SettingsSliderSpec(
          id: 'masterVolume',
          label: 'Master volume',
          optionKey: 'masterVolume',
          min: 0,
          max: 1,
          steps: 10,
        ),
        SettingsSliderSpec(
          id: 'sfxVolume',
          label: 'SFX volume',
          optionKey: 'sfxVolume',
          min: 0,
          max: 1,
          steps: 10,
        ),
        SettingsDropdownSpec(
          id: 'colorblindMode',
          label: 'Colorblind',
          optionKey: 'colorblindMode',
          options: {
            'none': 'None',
            'protanopia': 'Protanopia',
            'deuteranopia': 'Deuteranopia',
            'tritanopia': 'Tritanopia',
          },
        ),
        SettingsToggleSpec(
          id: 'reduceMotion',
          label: 'Reduce motion',
          optionKey: 'reduceMotion',
        ),
        SettingsSliderSpec(
          id: 'screenShakeIntensity',
          label: 'Screen shake',
          optionKey: 'screenShakeIntensity',
          min: 0,
          max: 1,
          steps: 10,
        ),
        SettingsSliderSpec(
          id: 'textScale',
          label: 'Text size',
          optionKey: 'textScale',
          min: 0.5,
          max: 2,
          steps: 6,
        ),
      ];

  @override
  void onValueChanged(String key, dynamic value) {
    if (key == 'masterVolume' || key == 'sfxVolume') {
      final o = game.options.options;
      game.audio.setMusicVolume(o.masterVolume * o.musicVolume);
    }
  }
}

