import 'dart:math';
import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:flutter/material.dart' hide Velocity;

// Generated by `game_agent create` — replace this with your own game.
// EngineView owns the game loop and rendering; you just build a World,
// spawn entities with components, and hand it off.

void main() => runApp(const GameApp());

class GameApp extends StatelessWidget {
  const GameApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: GameScreen(),
    );
  }
}

class GameScreen extends StatefulWidget {
  const GameScreen({super.key});

  @override
  State<GameScreen> createState() => _GameScreenState();
}

class _GameScreenState extends State<GameScreen> {
  static const worldW = 800.0;
  static const worldH = 600.0;

  late final Future<World> _worldFuture;

  @override
  void initState() {
    super.initState();
    _worldFuture = _buildWorld();
  }

  Future<World> _buildWorld() async {
    final world = World(width: worldW, height: worldH);
    registerCoreComponents(world);
    registerFlutterComponents(world);
    world.addSystem(MovementSystem());
    world.addSystem(CollisionSystem());
    world.addSystem(AnimationSystem());

    final atlasRegistry = AtlasRegistry();
    atlasRegistry.register('default', await _placeholderAtlas());
    _atlasRegistry = atlasRegistry;

    final rng = Random();
    for (var i = 0; i < 40; i++) {
      final id = world.spawn();
      final speed = 60 + rng.nextDouble() * 100;
      final angle = rng.nextDouble() * 2 * pi;
      world.storeOf<Position>().set(
            id,
            Position(rng.nextDouble() * worldW, rng.nextDouble() * worldH),
          );
      world.storeOf<Velocity>().set(
            id,
            Velocity(cos(angle) * speed, sin(angle) * speed),
          );
      world.storeOf<Collider>().set(id, Collider(16));
      world.storeOf<Sprite>().set(id, Sprite('default', 'circle'));
    }

    return world;
  }

  AtlasRegistry? _atlasRegistry;

  /// A generated placeholder sprite so the template works out of the box
  /// with no bundled asset files. Replace with a real sprite sheet loaded
  /// via `rootBundle` + `ui.instantiateImageCodec` for an actual game.
  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawCircle(
      const Offset(size / 2, size / 2),
      size / 2,
      Paint()..color = Colors.cyanAccent,
    );
    final image = await recorder.endRecording().toImage(size.toInt(), size.toInt());
    return SpriteAtlas(image, {
      'circle': const Rect.fromLTWH(0, 0, size, size),
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      body: FutureBuilder<World>(
        future: _worldFuture,
        builder: (context, snapshot) {
          if (!snapshot.hasData) {
            return const Center(child: CircularProgressIndicator());
          }
          return Center(
            child: AspectRatio(
              aspectRatio: worldW / worldH,
              child: ClipRect(
                child: EngineView(
                  world: snapshot.data!,
                  atlasRegistry: _atlasRegistry!,
                  camera: Camera(x: worldW / 2, y: worldH / 2),
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}
