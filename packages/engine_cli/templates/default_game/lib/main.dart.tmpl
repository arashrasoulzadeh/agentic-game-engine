import 'dart:convert';
import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:engine_platformer/engine_platformer.dart';
import 'package:flutter/material.dart' hide Velocity, Action;
import 'package:flutter/services.dart' show rootBundle;

const _playtestLevel = String.fromEnvironment('PLAYTEST_LEVEL');

// Set by the studio's play-test (and usable with `flutter run
// --dart-define=ASSET_DIR=<abs path to assets>`): levels are read from disk and
// the scene restarts when the level file is saved. Unset in release builds.
const _assetDir = String.fromEnvironment('ASSET_DIR');

// Generated by `game_agent create` — replace this with your own game.
//
// - assets/game_config.json controls orientation, world size, and other
//   app-level settings without touching Dart.
// - assets/levels/main.level.json is the starting level's tile geometry
//   and player entity, authored as data (see engine_core's `Level`/
//   `TileMap` — a "legend" + ASCII `rows` shape is the human-readable
//   way to write a tile grid by hand) rather than hand-spawned in Dart.
// - MyGame.createInitialScene returns the first Scene GameRunner loads.
// - MainScene.populate loads that level, attaches the live InputState the
//   player needs to read keyboard input, and wires up the systems a
//   platformer needs (installPlatformerSystems). A game with more than
//   one level/room adds more Scene subclasses and switches between them
//   via the SceneController handed to `populate` — see
//   `installRoomExitTrigger`/`RoomExit` for door-driven transitions.
// - MainScene.loadAssets loads sprite atlases before the first frame.

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  runGame(MyGame(config));
}

class MyGame extends Game {
  MyGame(this._config);

  final GameConfig _config;
  final InputController _inputController = InputController();

  @override
  GameConfig get config => _config;

  @override
  InputController createInputController() => _inputController;

  @override
  Scene createInitialScene() => MainScene(_inputController);
}

class MainScene extends Scene {
  MainScene(this._inputController);

  final InputController _inputController;
  late EntityId _player;
  AssetHotReloader? _reloader;

  @override
  Camera createCamera(World world) => Camera(zoom: 1);

  @override
  EntityId? cameraFollowEntity(World world) => _player;

  @override
  Future<void> populate(World world, SceneController scenes, GameState state) async {
    registerPlatformerComponents(world);

    // The studio's play-test passes PLAYTEST_LEVEL to load its snapshot of the
    // level being edited, instead of the saved starting level.
    final levelAsset = _playtestLevel.isEmpty
        ? 'assets/levels/main.level.json'
        : 'assets/levels/$_playtestLevel';
    final diskAssets = _assetDir.isEmpty ? null : directoryAssetSource(_assetDir);
    final levelPath = levelAsset.substring('assets/'.length);
    final levelText = diskAssets == null
        ? await rootBundle.loadString(levelAsset)
        : utf8.decode(await diskAssets.read(levelPath));
    final levelJson = jsonDecode(levelText) as Map<String, dynamic>;
    final named = Level.loadInto(world, levelJson);

    // The player's physics/sprite come from main.level.json via
    // Level.loadInto above. What's left is what a level file can't
    // express: the live InputState instance, tied to this running
    // game's InputController.
    _player = named['player']!;
    world.storeOf<InputState>().set(_player, _inputController.state);

    // installPlatformerSystems registers every system a platformer needs
    // in the one order that's actually correct (gravity -> movement ->
    // tile collision -> jump -> ...) — add your own systems/behaviors on
    // top of it, not in place of it.
    installPlatformerSystems(world, player: _player, behaviors: BehaviorRegistry());

    // Entity ids change on a level reload and the systems above hold the
    // player's, so a saved level restarts the scene (which re-reads the file)
    // rather than patching the live world.
    if (diskAssets != null) {
      _reloader?.stop();
      _reloader = AssetHotReloader(
        source: diskAssets,
        handlers: [
          CallbackAssetHandler({levelPath}, (_) => scenes.loadScene(MainScene(_inputController))),
        ],
      )..start();
    }
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    final atlasRegistry = AtlasRegistry();
    atlasRegistry.register('default', await _placeholderAtlas());
    return atlasRegistry;
  }

  /// A generated placeholder sprite so the template works out of the box
  /// with no bundled image files. Replace with a real sprite sheet loaded
  /// via `SpriteAtlas.loadFromAssets` for an actual game.
  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawRect(
      const Rect.fromLTWH(0, 0, size, size),
      Paint()..color = Colors.cyanAccent,
    );
    final image =
        await recorder.endRecording().toImage(size.toInt(), size.toInt());
    return SpriteAtlas(image, {
      'player': const Rect.fromLTWH(0, 0, size, size),
    });
  }
}
