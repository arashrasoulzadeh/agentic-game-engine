import 'dart:math';
import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:flutter/material.dart' hide Velocity;

// Generated by `game_agent create` — replace this with your own game.
//
// - assets/game_config.json controls orientation, world size, and other
//   app-level settings without touching Dart.
// - MyGame.createInitialScene returns the first Scene GameRunner loads.
// - MainScene.populate adds systems and spawns entities; GameRunner
//   (via runGame) already built the World and registered the built-in
//   components for you. A game with more than one level/room adds more
//   Scene subclasses and switches between them via the SceneController
//   handed to `populate`.
// - MainScene.loadAssets loads sprite atlases before the first frame.

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  runGame(MyGame(config));
}

class MyGame extends Game {
  MyGame(this._config);

  final GameConfig _config;

  @override
  GameConfig get config => _config;

  @override
  Scene createInitialScene() => MainScene();
}

class MainScene extends Scene {
  @override
  Future<void> populate(World world, SceneController scenes) async {
    world.addSystem(MovementSystem());
    world.addSystem(CollisionSystem());
    world.addSystem(AnimationSystem());

    final rng = Random();
    for (var i = 0; i < 40; i++) {
      final id = world.spawn();
      final speed = 60 + rng.nextDouble() * 100;
      final angle = rng.nextDouble() * 2 * pi;
      world.storeOf<Position>().set(
            id,
            Position(
              rng.nextDouble() * world.width,
              rng.nextDouble() * world.height,
            ),
          );
      world.storeOf<Velocity>().set(
            id,
            Velocity(cos(angle) * speed, sin(angle) * speed),
          );
      world.storeOf<Collider>().set(id, Collider(16));
      world.storeOf<Sprite>().set(id, Sprite('default', 'circle'));
    }
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    final atlasRegistry = AtlasRegistry();
    atlasRegistry.register('default', await _placeholderAtlas());
    return atlasRegistry;
  }

  /// A generated placeholder sprite so the template works out of the box
  /// with no bundled image files. Replace with a real sprite sheet
  /// loaded via `rootBundle` + `ui.instantiateImageCodec` for an actual
  /// game.
  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawCircle(
      const Offset(size / 2, size / 2),
      size / 2,
      Paint()..color = Colors.cyanAccent,
    );
    final image =
        await recorder.endRecording().toImage(size.toInt(), size.toInt());
    return SpriteAtlas(image, {
      'circle': const Rect.fromLTWH(0, 0, size, size),
    });
  }
}
