import 'package:engine_flutter/engine_flutter.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{PROJECT_NAME}}/main.dart';

void main() {
  testWidgets('game boots and renders', (tester) async {
    final game = MyGame(const GameConfig(worldWidth: 384, worldHeight: 432));
    await tester.pumpWidget(MaterialApp(home: GameRunner(game: game)));

    await tester.pump();
    await tester.pump();

    expect(find.byType(EngineView), findsOneWidget);

    // Run the simulation for a moment so fog, vision and the AI systems execute
    // against the real scene (a wiring mistake shows up as an exception here).
    for (var i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    expect(tester.takeException(), isNull);
  });
}
