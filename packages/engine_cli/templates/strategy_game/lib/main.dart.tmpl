import 'dart:convert';
import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:engine_strategy/engine_strategy.dart';
import 'package:flutter/material.dart' hide Velocity, Action, Text;
import 'package:flutter/services.dart' show LogicalKeyboardKey, rootBundle;

// Generated by `game_agent create --template strategy_game`.
// Map + units: assets/levels/skirmish.level.json. Escape → pause / settings / credits.

const _cell = 48.0;
const _grid = 8;
const _mountain = 3;
const _forest = 2;

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  final options = await createPlayerOptionsManager();
  runGame(MyGame(config, options));
}

class MyGame extends Game {
  MyGame(this._config, this.options);

  final GameConfig _config;
  final PlayerOptionsManager options;
  final AudioManager audio = AudioManager();

  late final InputController _input = InputController(
    bindings: {
      ...InputController.defaultBindings(),
      LogicalKeyboardKey.escape: 'pause',
    },
  );

  @override
  GameConfig get config => _config;

  @override
  String get colorblindMode => options.options.colorblindMode;

  @override
  double get screenShakeIntensity {
    final o = options.options;
    return o.reduceMotion ? 0 : o.screenShakeIntensity;
  }

  @override
  InputController createInputController() => _input;

  @override
  Scene createInitialScene() => SkirmishScene(this);
}

class SkirmishScene extends Scene {
  SkirmishScene(this.game);

  final MyGame game;
  final _taps = GridTapController(_cell);
  late EntityId _label;
  late SceneController _scenes;
  bool _pauseHeld = false;

  @override
  Future<void> populate(World world, SceneController scenes, GameState state) async {
    _scenes = scenes;
    final levelJson = jsonDecode(await rootBundle.loadString('assets/levels/skirmish.level.json'))
        as Map<String, dynamic>;
    Level.loadInto(world, levelJson);

    final map = world.storeOf<TileMap>().denseAt(0);
    final nav = GridNavigator.fromTileMap(map, terrainCosts: {_forest: 3});
    installStrategySystems(
      world,
      navigator: nav,
      cellSize: _cell,
      aiTeams: {'blue': TacticalAI(navigator: nav)},
      fog: true,
      blocksSight: (col, row) => map.tileAt(col, row) == _mountain,
      fogShade: (
        team: 'red',
        atlasId: 'terrain',
        unknownRegion: 'fog_unknown',
        exploredRegion: 'fog_explored',
        clearRegion: 'fog_clear',
      ),
      moveHighlight: (atlasId: 'terrain', region: 'highlight'),
    );

    _label = world.spawn();
    world.storeOf<Position>().set(_label, Position(_grid * _cell / 2, _grid * _cell + _cell / 2));
    world.storeOf<Text>().set(_label, Text('red to move -- tap here to end turn (Esc: pause)'));

    startTurnBasedGame(world, ['red', 'blue']);

    world.events.on<TurnStartedEvent>((e) {
      clearSelection(world);
      world.storeOf<Text>().get(_label)!.text =
          e.team == 'red' ? 'your move -- tap here to end turn' : 'blue is thinking...';
    });
    world.events.on<VictoryEvent>((e) {
      world.storeOf<Text>().get(_label)!.text = '${e.team} wins!';
    });
  }

  @override
  void update(double dt, World world) {
    final down = game._input.state.isPressed('pause');
    if (down && !_pauseHeld) {
      _scenes.pushOverlay(PauseMenu(game));
    }
    _pauseHeld = down;
  }

  @override
  void handleTap(World world, SceneController scenes, ui.Offset worldPosition) {
    final state = turnStateOf(world);
    if (state == null || state.activeTeam != 'red') return;
    if (worldPosition.dy >= _grid * _cell) {
      endTurn(world);
      return;
    }
    _taps.handleTap(world, worldPosition);
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    final registry = AtlasRegistry();
    registry.register('units', await _placeholderAtlas());
    registry.register('terrain', await _terrainAtlas());
    return registry;
  }

  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawRect(const Rect.fromLTWH(0, 0, size, size), Paint()..color = Colors.redAccent);
    canvas.drawRect(const Rect.fromLTWH(size, 0, size, size), Paint()..color = Colors.lightBlueAccent);
    final image = await recorder.endRecording().toImage(size.toInt() * 2, size.toInt());
    return SpriteAtlas(image, {
      'red': const Rect.fromLTWH(0, 0, size, size),
      'blue': const Rect.fromLTWH(size, 0, size, size),
    });
  }

  Future<SpriteAtlas> _terrainAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    void tile(int index, Color color) => canvas.drawRect(
          Rect.fromLTWH(index * size, 0, size, size),
          Paint()..color = color,
        );
    tile(0, const Color(0xFF3B6B3A));
    tile(1, const Color(0xFF1F4A2A));
    tile(2, const Color(0xFF6E6E78));
    tile(3, const Color(0x6640E0D0));
    tile(4, const Color(0xFF000000));
    tile(5, const Color(0x99000000));
    final image = await recorder.endRecording().toImage(size.toInt() * 7, size.toInt());
    return SpriteAtlas(image, {
      'grass': const Rect.fromLTWH(0, 0, size, size),
      'forest': const Rect.fromLTWH(size, 0, size, size),
      'mountain': const Rect.fromLTWH(size * 2, 0, size, size),
      'highlight': const Rect.fromLTWH(size * 3, 0, size, size),
      'fog_unknown': const Rect.fromLTWH(size * 4, 0, size, size),
      'fog_explored': const Rect.fromLTWH(size * 5, 0, size, size),
      'fog_clear': const Rect.fromLTWH(size * 6, 0, size, size),
    });
  }
}

class PauseMenu extends ButtonMenuScene {
  PauseMenu(this.game);
  final MyGame game;

  @override
  List<MenuButtonSpec> buttons() => const [
        MenuButtonSpec(label: 'Resume', actionId: 'resume'),
        MenuButtonSpec(label: 'Settings', actionId: 'settings'),
        MenuButtonSpec(label: 'Credits', actionId: 'credits'),
      ];

  @override
  void onButtonPressed(String actionId, SceneController scenes) {
    switch (actionId) {
      case 'resume':
        scenes.popOverlay();
      case 'settings':
        scenes.pushOverlay(GameSettingsMenu(game)..optionsManager = game.options);
      case 'credits':
        scenes.pushOverlay(GameCredits());
    }
  }
}

class GameSettingsMenu extends SettingsMenuScene {
  GameSettingsMenu(this.game);
  final MyGame game;

  @override
  String? get title => 'Settings';

  @override
  List<SettingsWidgetSpec> get widgets => const [
        SettingsSliderSpec(
          id: 'masterVolume',
          label: 'Master volume',
          optionKey: 'masterVolume',
          min: 0,
          max: 1,
          steps: 10,
        ),
        SettingsDropdownSpec(
          id: 'colorblindMode',
          label: 'Colorblind',
          optionKey: 'colorblindMode',
          options: {
            'none': 'None',
            'protanopia': 'Protanopia',
            'deuteranopia': 'Deuteranopia',
            'tritanopia': 'Tritanopia',
          },
        ),
        SettingsToggleSpec(
          id: 'reduceMotion',
          label: 'Reduce motion',
          optionKey: 'reduceMotion',
        ),
        SettingsSliderSpec(
          id: 'screenShakeIntensity',
          label: 'Screen shake',
          optionKey: 'screenShakeIntensity',
          min: 0,
          max: 1,
          steps: 10,
        ),
        SettingsSliderSpec(
          id: 'textScale',
          label: 'Text size',
          optionKey: 'textScale',
          min: 0.5,
          max: 2,
          steps: 6,
        ),
      ];

  @override
  void onValueChanged(String key, dynamic value) {
    if (key == 'masterVolume') {
      game.audio.setMusicVolume(game.options.options.masterVolume);
    }
  }
}

class GameCredits extends CreditsScene {
  @override
  List<CreditsEntry> get credits => const [
        CreditsEntry('{{PROJECT_NAME}}', style: CreditsStyle.title),
        CreditsEntry(''),
        CreditsEntry('Built with agentic-game-engine', style: CreditsStyle.section),
        CreditsEntry('Tap to close'),
      ];
}
