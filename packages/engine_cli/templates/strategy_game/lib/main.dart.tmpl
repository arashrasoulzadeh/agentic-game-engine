import 'dart:ui' as ui;

import 'package:engine_core/engine_core.dart';
import 'package:engine_flutter/engine_flutter.dart';
import 'package:engine_strategy/engine_strategy.dart';
import 'package:flutter/material.dart' hide Velocity, Action, Text;

// Generated by `game_agent create --template strategy_game` -- replace
// this with your own game.
//
// A turn-based skirmish against a simple AI (blue) on an 8x8 grid:
// - Tap one of your units to select it (a bar appears under it), then tap
//   a cell to move there, or an enemy to attack it (it walks into range).
// - Tap the strip below the grid to end your turn; blue then plays
//   its turn automatically.
// - assets/game_config.json sets the world size (grid + one button row).
// - Rules live in engine_core (turn clock, orders, combat, fog);
//   installStrategySystems wires them in the correct order.

const _cell = 48.0;
const _grid = 8;

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  runGame(MyGame(config));
}

class MyGame extends Game {
  MyGame(this._config);

  final GameConfig _config;

  @override
  GameConfig get config => _config;

  @override
  Scene createInitialScene() => SkirmishScene();
}

class SkirmishScene extends Scene {
  final _taps = GridTapController(_cell);
  late EntityId _label;

  @override
  Future<void> populate(World world, SceneController scenes, GameState state) async {
    installStrategySystems(
      world,
      navigator: GridNavigator(cols: _grid, rows: _grid, terrainCost: (_, _) => 1),
      cellSize: _cell,
      // Blue is the computer. Remove this line for hot-seat play, or
      // pass your own TurnAI (anything that calls submitOrder).
      aiTeams: {'blue': AggressiveAI()},
    );

    spawnStrategyUnit(world,
        team: 'red', col: 1, row: 6, cellSize: _cell, atlasId: 'units', spriteRegion: 'red');
    spawnStrategyUnit(world,
        team: 'red', col: 2, row: 6, cellSize: _cell, atlasId: 'units', spriteRegion: 'red');
    spawnStrategyUnit(world,
        team: 'blue', col: 5, row: 1, cellSize: _cell, atlasId: 'units', spriteRegion: 'blue');
    spawnStrategyUnit(world,
        team: 'blue', col: 6, row: 1, cellSize: _cell, atlasId: 'units', spriteRegion: 'blue');

    _label = world.spawn();
    world.storeOf<Position>().set(_label, Position(_grid * _cell / 2, _grid * _cell + _cell / 2));
    world.storeOf<Text>().set(_label, Text('red to move -- tap here to end turn'));

    startTurnBasedGame(world, ['red', 'blue']);

    world.events.on<TurnStartedEvent>((e) {
      clearSelection(world);
      world.storeOf<Text>().get(_label)!.text =
          e.team == 'red' ? 'your move -- tap here to end turn' : 'blue is thinking...';
    });
    world.events.on<VictoryEvent>((e) {
      world.storeOf<Text>().get(_label)!.text = '${e.team} wins!';
    });
  }

  @override
  void handleTap(World world, SceneController scenes, ui.Offset worldPosition) {
    final state = turnStateOf(world);
    if (state == null || state.activeTeam != 'red') return;
    if (worldPosition.dy >= _grid * _cell) {
      endTurn(world);
      return;
    }
    _taps.handleTap(world, worldPosition);
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    final registry = AtlasRegistry();
    registry.register('units', await _placeholderAtlas());
    return registry;
  }

  /// Generated placeholder sprites so the template runs with no bundled
  /// images. Replace with a real sheet via `SpriteAtlas.loadFromAssets`.
  Future<SpriteAtlas> _placeholderAtlas() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawRect(const Rect.fromLTWH(0, 0, size, size), Paint()..color = Colors.redAccent);
    canvas.drawRect(const Rect.fromLTWH(size, 0, size, size), Paint()..color = Colors.lightBlueAccent);
    final image = await recorder.endRecording().toImage(size.toInt() * 2, size.toInt());
    return SpriteAtlas(image, {
      'red': const Rect.fromLTWH(0, 0, size, size),
      'blue': const Rect.fromLTWH(size, 0, size, size),
    });
  }
}
