import 'dart:convert';
import 'dart:io';

import 'package:engine_core/engine_core.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{PROJECT_NAME}}/main.dart';

void main() {
  testWidgets('the idle game boots, taps earn coins and a generator can be bought', (tester) async {
    final definition = jsonDecode(File('assets/idle_game.json').readAsStringSync()) as Map<String, dynamic>;
    final options = PlayerOptionsManager(InMemoryPlayerOptionsStorage());
    // Memory store: avoids path_provider / disk in widget tests.
    await tester.pumpWidget(
      IdleApp(
        definition: definition,
        saveStore: MemorySaveStore(),
        optionsManager: options,
      ),
    );
    await tester.pump();
    await tester.pump(); // finish async boot

    expect(find.byKey(const Key('amount-coins')), findsOneWidget);
    expect(find.byKey(const Key('amount-gems')), findsOneWidget);
    expect(find.byKey(const Key('amount-stars')), findsOneWidget);
    expect(find.text('Cursor'), findsOneWidget);

    // The starting 15 coins buy one cursor.
    await tester.tap(find.byKey(const Key('buy-cursor-×1')));
    await tester.pump();
    expect(tester.widget<Text>(find.byKey(const Key('owned-cursor'))).data, '1');

    await tester.tap(find.byKey(const Key('tap')));
    await tester.pump();
    expect(tester.takeException(), isNull);

    // Prestige shop filters gem-cost upgrades.
    await tester.tap(find.text('Shop'));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('prestige-shop-gems')), findsOneWidget);
    expect(find.byKey(const Key('upgrade-gem_boost')), findsOneWidget);

    // Progress: prestige layers, research, time warp, achievements.
    await tester.tap(find.text('Progress'));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('prestige-button')), findsOneWidget);
    expect(find.byKey(const Key('prestige-button-ascend')), findsOneWidget);
    expect(find.byKey(const Key('research-mining')), findsOneWidget);
    expect(find.byKey(const Key('season-pass')), findsOneWidget);
    expect(find.byKey(const Key('timewarp-hour')), findsOneWidget);
    expect(find.byKey(const Key('achievement-ten_cursors')), findsOneWidget);

    // Settings: number format + volumes persist via PlayerOptions.
    await tester.tap(find.text('Settings'));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('settings-number-style')), findsOneWidget);
    expect(find.byKey(const Key('settings-decimal-separator')), findsOneWidget);
    expect(find.byKey(const Key('settings-master-volume')), findsOneWidget);
    expect(find.byKey(const Key('settings-sfx-volume')), findsOneWidget);
    await tester.tap(find.text('1.5e6'));
    await tester.pump();
    expect(options.getOption('numberStyle'), 'scientific');

    await tester.tap(find.byKey(const Key('save-export')));
    await tester.pump();
    expect(tester.widget<SelectableText>(find.byKey(const Key('save-code'))).data, startsWith('GSAVE1.'));
    expect(tester.takeException(), isNull);

    // Pause freezes the economy and offers settings / credits.
    await tester.tap(find.byKey(const Key('pause')));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('pause-resume')), findsOneWidget);
    await tester.tap(find.byKey(const Key('pause-credits')));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('idle-credits')), findsOneWidget);
    await tester.tap(find.byKey(const Key('idle-credits-close')));
    await tester.pumpAndSettle();

    // A golden offer, when one is showing, pays out through the same widget.
    await tester.tap(find.text('Generators'));
    await tester.pumpAndSettle();
    expect(find.byKey(const Key('golden-offer')), findsNothing, reason: 'none has appeared yet');

    // Leave the tree so the controller's timer is disposed.
    await tester.pumpWidget(const SizedBox());
  });
}
