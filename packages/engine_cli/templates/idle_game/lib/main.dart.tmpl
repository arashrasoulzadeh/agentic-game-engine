import 'dart:convert';

import 'package:engine_core/engine_core.dart';
import 'package:engine_idle/engine_idle.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart' show rootBundle;

// Generated by `game_agent create --template idle_game` - replace this with your own game.
//
// - assets/idle_game.json is the whole game as data: resources, generators, upgrades,
//   achievements, prestige and the offline-progress rules. Edit it (and check balance with
//   `dart run tool/simulate.dart` from the engine_idle package) without touching Dart.
// - IdleController steps the world and notifies the widgets; IdleSession saves, restores and pays
//   offline progress; IdleLifecycleHost ties the session to the app lifecycle.
// - Saving uses BrowserSaveStore: localStorage on the web, in memory elsewhere. On mobile/desktop use
//   `FileSaveStore('<documents dir>/save.json')` instead (get the directory with the path_provider package).
// - The Progress tab shows prestige and achievements; Settings has the number format and a save code you
//   can copy to another device.

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final definition = jsonDecode(await rootBundle.loadString('assets/idle_game.json')) as Map<String, dynamic>;
  runApp(IdleApp(definition: definition));
}

class IdleApp extends StatelessWidget {
  const IdleApp({super.key, required this.definition});

  final Map<String, dynamic> definition;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '{{PROJECT_NAME}}',
      theme: ThemeData(colorSchemeSeed: Colors.deepOrange, useMaterial3: true),
      home: IdleHome(definition: definition),
    );
  }
}

class IdleHome extends StatefulWidget {
  const IdleHome({super.key, required this.definition});

  final Map<String, dynamic> definition;

  @override
  State<IdleHome> createState() => _IdleHomeState();
}

class _IdleHomeState extends State<IdleHome> {
  late final IdleController controller;
  late final IdleSession session;

  @override
  void initState() {
    super.initState();
    final world = World(width: 10, height: 10);
    registerCoreComponents(world);
    final game = loadIdleDefinition(world, widget.definition);
    world
      ..addSystem(IdleSystem())
      ..addSystem(BoostSystem());
    controller = IdleController(world: world)..start();
    session = IdleSession(controller: controller, store: BrowserSaveStore(), offline: game.offline)
      ..load()
      ..startAutosave();
  }

  @override
  void dispose() {
    session.dispose();
    controller.dispose();
    super.dispose();
  }

  void _showAway(OfflineSummary summary) {
    showDialog<void>(
      context: context,
      builder: (_) => OfflineSummaryDialog(summary: summary, format: controller.format),
    );
  }

  @override
  Widget build(BuildContext context) {
    return IdleLifecycleHost(
      session: session,
      onAway: _showAway,
      child: DefaultTabController(
        length: 4,
        child: Scaffold(
          appBar: AppBar(
            title: const Text('{{PROJECT_NAME}}'),
            bottom: const TabBar(
              isScrollable: true,
              tabs: [Tab(text: 'Generators'), Tab(text: 'Upgrades'), Tab(text: 'Progress'), Tab(text: 'Settings')],
            ),
          ),
          body: Column(
            children: [
              Padding(
                padding: const EdgeInsets.all(12),
                child: ResourceHeader(controller: controller, resources: const ['coins', 'gems']),
              ),
              FilledButton(
                key: const Key('tap'),
                onPressed: controller.tap,
                child: const Padding(padding: EdgeInsets.all(12), child: Text('Tap')),
              ),
              Expanded(
                child: TabBarView(
                  children: [
                    GeneratorList(controller: controller),
                    UpgradeList(controller: controller),
                    Column(
                      children: [
                        Padding(padding: const EdgeInsets.all(12), child: PrestigePanel(controller: controller)),
                        Expanded(child: AchievementList(controller: controller)),
                      ],
                    ),
                    SingleChildScrollView(
                      padding: const EdgeInsets.all(12),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          IdleSettingsPanel(controller: controller, offline: session.offline),
                          const SizedBox(height: 24),
                          SaveCodePanel(session: session),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
