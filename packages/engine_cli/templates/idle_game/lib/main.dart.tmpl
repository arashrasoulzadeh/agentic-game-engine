// Generated by `game_agent create --template idle_game` - replace this with your own game.
//
// - assets/idle_game.json is the whole game as data: resources, generators, upgrades (including
//   synergy + gem prestige shop), achievements, prestige layers, challenges, auto-buyer, golden
//   offers and offline rules. Edit it (and check with `game_agent idle validate` / `idle simulate`)
//   without touching Dart.
// - Saves: BrowserSaveStore on web; FileSaveStore under app documents on mobile/desktop.
//   Tests can pass IdleApp(saveStore: MemorySaveStore()).
// - Number format + volumes persist via PlayerOptions (tests: IdleApp(optionsManager: ...)).
// - AppBar pause freezes the economy; Settings / Credits match the platformer shell UX.
// - IdleSfx hooks are wired as debugPrint stubs — swap for AudioManager.playSound.
// - Cold start and resume show offlineSummaryDialog; onDouble stubs a rewarded-ad double.
// - ReturnNotifier logs schedule/cancel — swap for flutter_local_notifications (or similar).

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final definition = jsonDecode(await rootBundle.loadString('assets/idle_game.json')) as Map<String, dynamic>;
  runApp(IdleApp(definition: definition));
}

Future<SaveStore> openIdleSaveStore() async {
  if (kIsWeb) return BrowserSaveStore();
  final dir = await getApplicationDocumentsDirectory();
  return FileSaveStore('${dir.path}/{{PROJECT_NAME}}_idle_save.json');
}

/// Demo [ReturnNotifier]: logs schedule/cancel. Replace with a real OS notification plugin.
class LogReturnNotifier implements ReturnNotifier {
  @override
  void schedule(Duration delay, String message) {
    debugPrint('ReturnNotifier: in $delay — $message');
  }

  @override
  void cancel() => debugPrint('ReturnNotifier: cancelled');
}

/// Demo [IdleSfx]: logs events. Replace with `AudioManager.playSound(...)` and multiply by
/// `options.options.masterVolume * options.options.sfxVolume`.
IdleSfx logIdleSfx() => IdleSfx(
      onBuy: () => debugPrint('SFX: buy'),
      onUpgrade: () => debugPrint('SFX: upgrade'),
      onTap: () => debugPrint('SFX: tap'),
      onPrestige: () => debugPrint('SFX: prestige'),
      onGolden: () => debugPrint('SFX: golden'),
    );

class IdleApp extends StatelessWidget {
  const IdleApp({
    super.key,
    required this.definition,
    this.saveStore,
    this.optionsManager,
  });

  final Map<String, dynamic> definition;

  /// Override for tests (`MemorySaveStore`); null opens the platform store.
  final SaveStore? saveStore;

  /// Override for tests (`PlayerOptionsManager(InMemoryPlayerOptionsStorage())`).
  final PlayerOptionsManager? optionsManager;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '{{PROJECT_NAME}}',
      theme: ThemeData(colorSchemeSeed: Colors.deepOrange, useMaterial3: true),
      home: IdleHome(
        definition: definition,
        saveStore: saveStore,
        optionsManager: optionsManager,
      ),
    );
  }
}

class IdleHome extends StatefulWidget {
  const IdleHome({
    super.key,
    required this.definition,
    this.saveStore,
    this.optionsManager,
  });

  final Map<String, dynamic> definition;
  final SaveStore? saveStore;
  final PlayerOptionsManager? optionsManager;

  @override
  State<IdleHome> createState() => _IdleHomeState();
}

class _IdleHomeState extends State<IdleHome> {
  IdleController? controller;
  IdleSession? session;
  PlayerOptionsManager? options;
  Object? bootError;

  @override
  void initState() {
    super.initState();
    _boot();
  }

  NumberStyle _styleFromOptions(PlayerOptionsManager o) {
    final name = o.getOption('numberStyle') as String? ?? 'suffix';
    for (final s in NumberStyle.values) {
      if (s.name == name) return s;
    }
    return NumberStyle.suffix;
  }

  Future<void> _persistStyle(NumberStyle style) async {
    await options?.setOption('numberStyle', style.name);
  }

  Future<void> _persistSeparator(String sep) async {
    await options?.setOption('decimalSeparator', sep);
  }

  Future<void> _boot() async {
    try {
      final store = widget.saveStore ?? await openIdleSaveStore();
      final opts = widget.optionsManager ?? await createPlayerOptionsManager();
      final world = World(width: 10, height: 10);
      registerCoreComponents(world);
      final game = loadIdleDefinition(world, widget.definition);
      world
        ..addSystem(IdleSystem())
        ..addSystem(AutoBuySystem())
        ..addSystem(BoostSystem())
        ..addSystem(GoldenEventSystem(DeterministicRandom(DateTime.now().millisecondsSinceEpoch)));
      final c = IdleController(
        world: world,
        style: _styleFromOptions(opts),
        decimalSeparator: opts.getOption('decimalSeparator') as String? ?? '.',
        sfx: logIdleSfx(),
      )..start();
      final s = IdleSession(
        controller: c,
        store: store,
        offline: game.offline,
        notifier: LogReturnNotifier(),
        whileAway: () {
          final buyers = c.world.storeOf<AutoBuyer>();
          if (buyers.length == 0) return;
          runAutoBuyer(c.world, c.wallet, buyers.denseAt(0));
        },
      );
      final away = s.load();
      s.startAutosave();
      if (!mounted) {
        s.dispose();
        c.dispose();
        return;
      }
      setState(() {
        controller = c;
        session = s;
        options = opts;
      });
      if (away != null) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (mounted) _showAway(away);
        });
      }
    } on Object catch (e) {
      if (mounted) setState(() => bootError = e);
    }
  }

  @override
  void dispose() {
    session?.dispose();
    controller?.dispose();
    super.dispose();
  }

  Future<void> _showAway(OfflineSummary summary) async {
    final doubled = await showDialog<bool>(
      context: context,
      builder: (_) => OfflineSummaryDialog(
        summary: summary,
        format: controller!.format,
        // Stub: pretend a rewarded ad succeeded. Replace with your ad SDK
        // (show → await reward → return true/false).
        onDouble: () async => true,
      ),
    );
    if (doubled == true) session?.doubleOffline(summary);
  }

  Future<void> _openPause() async {
    final c = controller;
    if (c == null) return;
    c.stop();
    await showIdlePauseMenu(
      context,
      onSettings: () => DefaultTabController.of(context).animateTo(4),
      onCredits: () => showIdleCredits(context, gameTitle: '{{PROJECT_NAME}}'),
    );
    if (mounted) c.start();
  }

  @override
  Widget build(BuildContext context) {
    if (bootError != null) {
      return Scaffold(body: Center(child: Text('Failed to start: $bootError')));
    }
    final c = controller;
    final s = session;
    final o = options;
    if (c == null || s == null || o == null) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }
    return IdleLifecycleHost(
      session: s,
      onAway: _showAway,
      child: DefaultTabController(
        length: 5,
        child: Scaffold(
          appBar: AppBar(
            title: const Text('{{PROJECT_NAME}}'),
            actions: [
              IconButton(
                key: const Key('pause'),
                tooltip: 'Pause',
                icon: const Icon(Icons.pause),
                onPressed: _openPause,
              ),
            ],
            bottom: const TabBar(
              isScrollable: true,
              tabs: [
                Tab(text: 'Generators'),
                Tab(text: 'Upgrades'),
                Tab(text: 'Shop'),
                Tab(text: 'Progress'),
                Tab(text: 'Settings'),
              ],
            ),
          ),
          body: Column(
            children: [
              Padding(
                padding: const EdgeInsets.all(12),
                child: ResourceHeader(controller: c, resources: c.resourceIds),
              ),
              FilledButton(
                key: const Key('tap'),
                onPressed: c.tap,
                child: const Padding(padding: EdgeInsets.all(12), child: Text('Tap')),
              ),
              GoldenOffer(controller: c),
              Expanded(
                child: TabBarView(
                  children: [
                    GeneratorList(controller: c),
                    UpgradeList(controller: c, costResource: 'coins'),
                    PrestigeShop(controller: c, currency: 'gems'),
                    ListView(
                      children: [
                        for (final id in c.prestigeRuleIds)
                          Padding(
                            padding: const EdgeInsets.all(12),
                            child: PrestigePanel(
                              controller: c,
                              ruleId: id == 'prestige' ? null : id,
                            ),
                          ),
                        Padding(padding: const EdgeInsets.symmetric(horizontal: 12), child: ChallengePanel(controller: c)),
                        Padding(padding: const EdgeInsets.all(12), child: StatsPanel(controller: c)),
                        const SizedBox(height: 12),
                        SizedBox(height: 320, child: AchievementList(controller: c)),
                      ],
                    ),
                    SingleChildScrollView(
                      padding: const EdgeInsets.all(12),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          IdleSettingsPanel(
                            controller: c,
                            offline: s.offline,
                            options: o,
                            onStyleChanged: _persistStyle,
                            onDecimalSeparatorChanged: _persistSeparator,
                          ),
                          const SizedBox(height: 24),
                          SaveCodePanel(session: s),
                          const SizedBox(height: 24),
                          TextButton(
                            key: const Key('open-credits'),
                            onPressed: () => showIdleCredits(
                              context,
                              gameTitle: '{{PROJECT_NAME}}',
                            ),
                            child: const Text('Credits'),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
