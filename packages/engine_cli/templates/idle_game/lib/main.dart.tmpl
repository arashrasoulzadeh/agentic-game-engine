import 'dart:convert';

import 'package:engine_core/engine_core.dart';
import 'package:engine_idle/engine_idle.dart';
import 'package:flutter/foundation.dart' show kIsWeb;
import 'package:flutter/material.dart';
import 'package:flutter/services.dart' show rootBundle;
import 'package:path_provider/path_provider.dart';

// Generated by `game_agent create --template idle_game` - replace this with your own game.
//
// - assets/idle_game.json is the whole game as data: resources, generators, upgrades,
//   achievements, prestige, challenges, golden offers and offline rules. Edit it (and check
//   with `game_agent idle validate` / `game_agent idle simulate`) without touching Dart.
// - Saves: BrowserSaveStore on web; FileSaveStore under app documents on mobile/desktop.
//   Tests can pass IdleApp(saveStore: MemorySaveStore()).
// - Cold start and resume both show OfflineSummaryDialog when catch-up credited time.
// - Optional: add "autoBuyer" to the JSON and AutoBuySystem() (see docs/concepts/idle-games.md).

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final definition = jsonDecode(await rootBundle.loadString('assets/idle_game.json')) as Map<String, dynamic>;
  runApp(IdleApp(definition: definition));
}

Future<SaveStore> openIdleSaveStore() async {
  if (kIsWeb) return BrowserSaveStore();
  final dir = await getApplicationDocumentsDirectory();
  return FileSaveStore('${dir.path}/{{PROJECT_NAME}}_idle_save.json');
}

class IdleApp extends StatelessWidget {
  const IdleApp({super.key, required this.definition, this.saveStore});

  final Map<String, dynamic> definition;

  /// Override for tests (`MemorySaveStore`); null opens the platform store.
  final SaveStore? saveStore;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '{{PROJECT_NAME}}',
      theme: ThemeData(colorSchemeSeed: Colors.deepOrange, useMaterial3: true),
      home: IdleHome(definition: definition, saveStore: saveStore),
    );
  }
}

class IdleHome extends StatefulWidget {
  const IdleHome({super.key, required this.definition, this.saveStore});

  final Map<String, dynamic> definition;
  final SaveStore? saveStore;

  @override
  State<IdleHome> createState() => _IdleHomeState();
}

class _IdleHomeState extends State<IdleHome> {
  IdleController? controller;
  IdleSession? session;
  Object? bootError;

  @override
  void initState() {
    super.initState();
    _boot();
  }

  Future<void> _boot() async {
    try {
      final store = widget.saveStore ?? await openIdleSaveStore();
      final world = World(width: 10, height: 10);
      registerCoreComponents(world);
      final game = loadIdleDefinition(world, widget.definition);
      world
        ..addSystem(IdleSystem())
        ..addSystem(BoostSystem())
        ..addSystem(GoldenEventSystem(DeterministicRandom(DateTime.now().millisecondsSinceEpoch)));
      final c = IdleController(world: world)..start();
      final s = IdleSession(controller: c, store: store, offline: game.offline);
      final away = s.load();
      s.startAutosave();
      if (!mounted) {
        s.dispose();
        c.dispose();
        return;
      }
      setState(() {
        controller = c;
        session = s;
      });
      if (away != null) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (mounted) _showAway(away);
        });
      }
    } on Object catch (e) {
      if (mounted) setState(() => bootError = e);
    }
  }

  @override
  void dispose() {
    session?.dispose();
    controller?.dispose();
    super.dispose();
  }

  void _showAway(OfflineSummary summary) {
    showDialog<void>(
      context: context,
      builder: (_) => OfflineSummaryDialog(
        summary: summary,
        format: controller!.format,
        // Wire a rewarded ad here: onDouble: () async { /* show ad */; return true; }
        // then IdleSession.doubleOffline applies the bonus once.
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (bootError != null) {
      return Scaffold(body: Center(child: Text('Failed to start: $bootError')));
    }
    final c = controller;
    final s = session;
    if (c == null || s == null) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }
    return IdleLifecycleHost(
      session: s,
      onAway: _showAway,
      child: DefaultTabController(
        length: 4,
        child: Scaffold(
          appBar: AppBar(
            title: const Text('{{PROJECT_NAME}}'),
            bottom: const TabBar(
              isScrollable: true,
              tabs: [Tab(text: 'Generators'), Tab(text: 'Upgrades'), Tab(text: 'Progress'), Tab(text: 'Settings')],
            ),
          ),
          body: Column(
            children: [
              Padding(
                padding: const EdgeInsets.all(12),
                child: ResourceHeader(controller: c, resources: const ['coins', 'gems']),
              ),
              FilledButton(
                key: const Key('tap'),
                onPressed: c.tap,
                child: const Padding(padding: EdgeInsets.all(12), child: Text('Tap')),
              ),
              GoldenOffer(controller: c),
              Expanded(
                child: TabBarView(
                  children: [
                    GeneratorList(controller: c),
                    UpgradeList(controller: c),
                    ListView(
                      children: [
                        Padding(padding: const EdgeInsets.all(12), child: PrestigePanel(controller: c)),
                        Padding(padding: const EdgeInsets.symmetric(horizontal: 12), child: ChallengePanel(controller: c)),
                        Padding(padding: const EdgeInsets.all(12), child: StatsPanel(controller: c)),
                        const SizedBox(height: 12),
                        SizedBox(height: 320, child: AchievementList(controller: c)),
                      ],
                    ),
                    SingleChildScrollView(
                      padding: const EdgeInsets.all(12),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          IdleSettingsPanel(controller: c, offline: s.offline),
                          const SizedBox(height: 24),
                          SaveCodePanel(session: s),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
