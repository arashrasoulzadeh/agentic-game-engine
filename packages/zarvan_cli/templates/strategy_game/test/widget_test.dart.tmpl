import 'package:zarvan_core/zarvan_core.dart';
import 'package:zarvan_flutter/zarvan_flutter.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{PROJECT_NAME}}/main.dart';

void main() {
  testWidgets('game boots and renders', (tester) async {
    final options = PlayerOptionsManager(InMemoryPlayerOptionsStorage());
    final game = MyGame(const GameConfig(worldWidth: 384, worldHeight: 432), options);
    await tester.pumpWidget(MaterialApp(home: GameRunner(game: game)));

    await tester.pump();
    await tester.pump();

    expect(find.byType(EngineView), findsOneWidget);

    for (var i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    expect(tester.takeException(), isNull);
  });
}
