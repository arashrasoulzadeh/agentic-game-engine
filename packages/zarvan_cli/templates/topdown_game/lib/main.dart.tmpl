import 'dart:ui' as ui;

import 'package:zarvan_core/zarvan_core.dart';
import 'package:zarvan_flutter/zarvan_flutter.dart';
import 'package:flutter/material.dart' hide Velocity, Action;

// Generated by `zarvan create --template topdown_game` — replace this with
// your own game. Arrow keys (or the on-screen joystick) move the player in
// four directions; touch a coin to collect it.

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final config = await GameConfig.loadFromAsset('assets/game_config.json');
  runGame(MyGame(config));
}

class MyGame extends Game {
  MyGame(this._config);

  final GameConfig _config;
  final InputController _input = InputController();

  @override
  GameConfig get config => _config;

  @override
  InputController createInputController() => _input;

  @override
  Scene createInitialScene() => MainScene(_input);
}

class MainScene extends Scene {
  MainScene(this.input);

  final InputController input;
  late EntityId _player;

  @override
  EntityId? cameraFollowEntity(World world) => _player;

  @override
  Future<void> populate(World world, SceneController scenes, GameState state) async {
    _player = world.spawnWith([
      Position(400, 300),
      Velocity(0, 0),
      Collider(14),
      Sprite('default', 'player'),
    ]);
    for (var i = 0; i < 5; i++) {
      world.spawnWith([
        Position(120.0 + i * 140, 200 + (i.isEven ? 0 : 200)),
        Collider(8),
        Sprite('default', 'coin'),
        EntityTags(['coin']),
      ]);
    }

    SystemPresets.core(world);
    world.addSystemFn('topdown-input', (world, dt) {
      final s = input.state;
      final v = world.getComponent<Velocity>(_player)!;
      v.x = ((s.isPressed('right') ? 1 : 0) - (s.isPressed('left') ? 1 : 0)) * 160.0 + s.axis('moveX') * 160;
      v.y = ((s.isPressed('down') ? 1 : 0) - (s.isPressed('up') ? 1 : 0)) * 160.0 + s.axis('moveY') * 160;
    }, phase: SystemPhase.prePhysics);
    world.addSystemFn('coin-pickup', (world, dt) {
      final p = world.getComponent<Position>(_player)!;
      for (final id in world.findNear(p.x, p.y, 22, exclude: _player)) {
        if (world.hasTag(id, 'coin')) world.commands.destroy(id);
      }
    });
  }

  @override
  Future<AtlasRegistry> loadAssets() async {
    const size = 32.0;
    final recorder = ui.PictureRecorder();
    final canvas = Canvas(recorder);
    canvas.drawCircle(const Offset(size / 2, size / 2), 14, Paint()..color = Colors.cyanAccent);
    canvas.drawCircle(const Offset(size * 1.5, size / 2), 8, Paint()..color = Colors.amber);
    final image = await recorder.endRecording().toImage(size.toInt() * 2, size.toInt());
    return AtlasRegistry()
      ..register(
        'default',
        SpriteAtlas(image, {
          'player': const Rect.fromLTWH(0, 0, size, size),
          'coin': const Rect.fromLTWH(size, 0, size, size),
        }),
      );
  }
}
