# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Monorepo packages (engine_core, engine_cli, future engine_flutter, etc.)
# each get their own build/.dart_tool artifacts — ignore them wherever
# they live.
packages/**/.dart_tool/
packages/**/build/
packages/**/.pub-cache/
packages/**/pubspec.lock
packages/**/coverage/

# This repo only tracks the engine itself (packages/). Any Flutter game
# scaffolded here via `game_agent create` (e.g. test_game/) is local-only
# dev/testing scratch — never committed.
/test_game/
/examples/
